# =============================================================================
# ENVIRONMENT CONFIGURATION -- eCommerce MVP (WhatsApp checkout, single-tenant)
# =============================================================================
# Copiar a .env y completar. NO commitear .env.
# Este archivo refleja las variables que el código realmente lee -- si
# agregás una env var nueva en el código, sumala acá también.
# =============================================================================

# =============================================================================
# BASE DE DATOS (PostgreSQL -- Supabase o Neon)
# =============================================================================
# Dos conexiones, no una -- así lo exige prisma/schema.prisma (datasource db).
# DATABASE_URL: conexión "pooled" (PgBouncer), la usa la app en cada request
# normal. En Supabase: Settings > Database > Connection string > "Transaction"
# (puerto 6543, con ?pgbouncer=true).
DATABASE_URL="postgresql://usuario:password@localhost:5432/ecommerce_db"
# DIRECT_URL: conexión directa sin pooler, la usa Prisma solo para correr
# migraciones (`prisma migrate deploy`) -- el modo pooled no soporta bien los
# cambios de esquema. En Supabase: misma pantalla, modo "Direct connection"
# (puerto 5432). En desarrollo local (Postgres propio) puede ser igual a
# DATABASE_URL.
DIRECT_URL="postgresql://usuario:password@localhost:5432/ecommerce_db"

# =============================================================================
# AUTENTICACIÓN (Auth.js v5)
# =============================================================================
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="genera-un-secreto-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth -- único método de login real para el admin del cliente.
# Credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# El único email que puede entrar a /admin logueándose con Google (ver
# callback signIn en lib/auth.ts). Sin esto, nadie puede entrar por Google.
ALLOWED_ADMIN_EMAIL="admin@tudominio.com"

# --- Login con correo y contraseña (alternativo a Google) ---
# Solo se activa si además STORE_CONFIG.permitirLoginConCredenciales es true
# en lib/store-config.ts (por cliente). ADMIN_PASSWORD_HASH es un hash de
# bcrypt, NUNCA la contraseña en texto plano. Para generarlo:
#   1) npm install bcryptjs (ya es dependencia del proyecto)
#   2) node -e "console.log(require('bcryptjs').hashSync('tu-contraseña-real', 10))"
#   3) pegar el resultado (empieza con $2a$ o $2b$) acá abajo
# ADMIN_LOGIN_EMAIL="admin@tudominio.com"
# ADMIN_PASSWORD_HASH="$2b$10$..."

# =============================================================================
# SUPABASE STORAGE (imágenes de producto/banner -- bucket público "product-images")
# =============================================================================
SUPABASE_URL="https://tu-proyecto.supabase.co"
# Service Role Key: server-only, jamás exponer al cliente. En:
# https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# CORREO (Nodemailer / SMTP)
# =============================================================================
# Usado para el formulario de contacto y la notificación de nuevos leads.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Buzón que recibe el contacto y las notificaciones de nuevo lead.
CONTACT_EMAIL_TO=""

# =============================================================================
# APLICACIÓN
# =============================================================================
# URL pública real del sitio (usada en sitemap, robots.txt y links de los
# correos). En Vercel, la URL de producción del proyecto.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"
