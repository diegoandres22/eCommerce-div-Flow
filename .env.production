# =============================================================================
# .env.production -- plantilla de variables para despliegue vía Docker
# (docker-compose.yml carga este archivo con env_file). Si el despliegue es
# en Vercel, estas mismas variables se cargan desde el dashboard del
# proyecto, no desde este archivo.
#
# Completar con los valores reales del cliente antes de levantar el
# contenedor. Mismo set de variables que .env.example -- ver ese archivo
# para la explicación de cada una.
# =============================================================================

DATABASE_URL="postgresql://ecommerce_user:ecommerce_password@postgres:5432/ecommerce_db"

NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://tudominio.com"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_ADMIN_EMAILS=""

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
CONTACT_EMAIL_TO=""

NEXT_PUBLIC_APP_URL="https://tudominio.com"

NODE_ENV="production"
