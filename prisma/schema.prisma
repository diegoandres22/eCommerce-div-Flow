// Location: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js v5 (estándar PrismaAdapter) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Catálogo ---

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Autorreferencia opcional: una categoría sin parentId es "principal";
  // con parentId es subcategoría de otra. Un solo nivel de anidamiento.
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products    Product[] @relation("ProductCategory")
  subProducts Product[] @relation("ProductSubCategory")

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  images      String[]

  // Antes "campoTexto1"/"campoNumero2" (nombres genéricos del MVP inicial),
  // renombrados a su uso real. `modelo` pasó de Float a String: es texto
  // libre ("Galaxy S23", "Air Max 90"), no un valor numérico.
  marca   String
  modelo  String
  // Colores del producto serializados como "Nombre:#hex,Nombre:#hex"
  // (ver lib/product-colors.ts). Opcional en la práctica: un producto sin
  // variantes de color guarda "".
  colores String
  // Tallas del producto serializadas como "38,39,40,41" o "S,M,L,XL" (ver
  // lib/product-sizes.ts) -- texto libre, numérico o letra, sin relación con
  // `colores`: un producto puede tener talla, color, ambos o ninguno.
  // Opcional en la práctica: un producto sin tallas guarda "".
  tallas String @default("")

  views     Int      @default(0)
  isActive  Boolean  @default(true)
  // Manual, usado solo cuando ConfiguracionTienda.controlStockActivo está
  // apagado (comportamiento original del MVP, sin conteo de stock).
  // Independiente de isActive: el producto sigue visible/indexable, pero
  // no se puede agregar al carrito.
  isOutOfStock Boolean @default(false)

  // --- Módulo de stock (opcional, activable vía controlStockActivo) ---
  // `stock`: cantidad disponible. Para productos sin colores es el número
  // que edita el admin directamente. Para productos con colores, es la suma
  // calculada de `colorStocks` (no se edita a mano en ese caso) -- así el
  // agregado nunca queda desincronizado del detalle por color.
  stock       Int @default(0)
  // Umbral para la alerta de "stock bajo" en el dashboard.
  stockMinimo Int @default(3)
  colorStocks ProductColorStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation("ProductCategory", fields: [categoryId], references: [id])

  // Subcategoría opcional (debe ser hija de `category` cuando se define;
  // esa consistencia se valida en la API, no a nivel de base de datos).
  subCategoryId String?
  subCategory   Category? @relation("ProductSubCategory", fields: [subCategoryId], references: [id])

  @@index([isActive])
  @@map("products")
}

// Stock por variante -- combinación de color y/o talla, para productos que
// tienen `colores` y/o `tallas` definidos (ver lib/product-colors.ts,
// lib/product-sizes.ts). `colorName`/`talla` referencian el nombre tal cual
// está en el string serializado del producto -- por nombre, no por índice,
// para no romperse si el admin reordena los colores/tallas.
//
// Una fila puede representar: un color solo (talla ""), una talla sola
// (colorName ""), o una combinación puntual de ambos -- según qué tenga el
// producto. Un producto sin colores NI tallas no usa esta tabla: su stock
// vive directo en `Product.stock`.
model ProductColorStock {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName String  @default("")
  talla     String  @default("")
  stock     Int     @default(0)

  @@unique([productId, colorName, talla])
  @@map("product_color_stock")
}

// Registro de intención de compra: se crea justo antes de redirigir al
// cliente a WhatsApp (ver lib/whatsapp.ts + cart-checkout.tsx), sin
// bloquear ni modificar ese flujo. No es un pedido con estados de envío ni
// un modelo de pagos -- es solo un rastro para que el admin sepa qué se
// cotizó, cuándo, y por cuánto, ya que WhatsApp por sí solo no deja ningún
// registro consultable desde el panel.
//
// `estado`: como no hay pasarela de pago, el clic en "Pedir por WhatsApp"
// NO implica que la venta se concretó. El descuento de stock (cuando
// ConfiguracionTienda.controlStockActivo está activo) ocurre recién cuando
// el admin confirma la venta manualmente desde /admin/leads -- ver
// app/api/admin/leads/[id]/route.ts. `pendiente` es el estado inicial de
// todo lead nuevo; `confirmado` ya descontó stock; `cancelado` es un
// pendiente rechazado (sin efecto en stock) o una venta confirmada que se
// revirtió (repone el stock que se había descontado).
model Lead {
  id          String     @id @default(cuid())
  items       Json
  totalAmount Float
  estado      LeadEstado @default(pendiente)
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([estado])
  @@map("leads")
}

enum LeadEstado {
  pendiente
  confirmado
  cancelado
}

// Registro de enlaces rotos: cada vez que se renderiza app/not-found.tsx se
// hace un upsert acá (path -> +1 hit), fire-and-forget, para que el admin
// pueda ver qué URLs inexistentes reciben más visitas (links viejos de
// campañas, productos borrados que todavía circulan, typos frecuentes en la
// barra de direcciones, etc.) sin tener que revisar logs de Vercel a mano.
model BrokenLink {
  id          String   @id @default(cuid())
  path        String   @unique
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([hits])
  @@index([lastSeenAt])
  @@map("broken_links")
}

// Contraparte "en positivo" de BrokenLink: mismo mecanismo de upsert
// (path -> +1 hit) pero para rutas que SÍ resolvieron con éxito, registradas
// desde app/(store)/layout.tsx -- que envuelve todo el sitio público, pero
// no a app/not-found.tsx (vive fuera del route group (store), así que un
// 404 nunca termina sumando acá por accidente). Sirve para ver a dónde va
// el usuario mayormente, sin mezclarse con el reporte de enlaces caídos.
model PageVisit {
  id          String   @id @default(cuid())
  path        String   @unique
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([hits])
  @@index([lastSeenAt])
  @@map("page_visits")
}

// --- Configuración de la Tienda ---

model ConfiguracionTienda {
  id             String  @id @default(cuid())
  whatsappNumber String
  bannerText     String?
  showBanner     Boolean @default(false)
  // Interruptor global del módulo de stock (ver Product.stock/stockMinimo,
  // ProductColorStock, Lead.estado). Apagado = comportamiento original del
  // MVP (isOutOfStock manual, sin descuentos ni validaciones de cantidad).
  controlStockActivo Boolean @default(false)

  @@map("configuracion_tienda")
}

// --- Banners del carrusel principal (home) ---

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}
