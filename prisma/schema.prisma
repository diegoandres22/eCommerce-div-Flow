// Location: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js v5 (estándar PrismaAdapter) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Catálogo ---

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Autorreferencia opcional: una categoría sin parentId es "principal";
  // con parentId es subcategoría de otra. Un solo nivel de anidamiento.
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products    Product[] @relation("ProductCategory")
  subProducts Product[] @relation("ProductSubCategory")

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  images      String[]

  // Antes "campoTexto1"/"campoNumero2" (nombres genéricos del MVP inicial),
  // renombrados a su uso real. `modelo` pasó de Float a String: es texto
  // libre ("Galaxy S23", "Air Max 90"), no un valor numérico.
  marca   String
  modelo  String
  // Colores del producto serializados como "Nombre:#hex,Nombre:#hex"
  // (ver lib/product-colors.ts). Opcional en la práctica: un producto sin
  // variantes de color guarda "".
  colores String

  views     Int      @default(0)
  isActive  Boolean  @default(true)
  // Independiente de isActive: el producto sigue visible/indexable, pero
  // no se puede agregar al carrito. No es control de inventario (sin
  // conteo de stock), es solo un interruptor de disponibilidad.
  isOutOfStock Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation("ProductCategory", fields: [categoryId], references: [id])

  // Subcategoría opcional (debe ser hija de `category` cuando se define;
  // esa consistencia se valida en la API, no a nivel de base de datos).
  subCategoryId String?
  subCategory   Category? @relation("ProductSubCategory", fields: [subCategoryId], references: [id])

  @@index([isActive])
  @@map("products")
}

// Registro de intención de compra: se crea justo antes de redirigir al
// cliente a WhatsApp (ver lib/whatsapp.ts + cart-checkout.tsx), sin
// bloquear ni modificar ese flujo. No es un pedido con estados de envío ni
// un modelo de pagos -- es solo un rastro para que el admin sepa qué se
// cotizó, cuándo, y por cuánto, ya que WhatsApp por sí solo no deja ningún
// registro consultable desde el panel.
model Lead {
  id          String   @id @default(cuid())
  items       Json
  totalAmount Float
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("leads")
}

// Registro de enlaces rotos: cada vez que se renderiza app/not-found.tsx se
// hace un upsert acá (path -> +1 hit), fire-and-forget, para que el admin
// pueda ver qué URLs inexistentes reciben más visitas (links viejos de
// campañas, productos borrados que todavía circulan, typos frecuentes en la
// barra de direcciones, etc.) sin tener que revisar logs de Vercel a mano.
model BrokenLink {
  id          String   @id @default(cuid())
  path        String   @unique
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([hits])
  @@index([lastSeenAt])
  @@map("broken_links")
}

// Contraparte "en positivo" de BrokenLink: mismo mecanismo de upsert
// (path -> +1 hit) pero para rutas que SÍ resolvieron con éxito, registradas
// desde app/(store)/layout.tsx -- que envuelve todo el sitio público, pero
// no a app/not-found.tsx (vive fuera del route group (store), así que un
// 404 nunca termina sumando acá por accidente). Sirve para ver a dónde va
// el usuario mayormente, sin mezclarse con el reporte de enlaces caídos.
model PageVisit {
  id          String   @id @default(cuid())
  path        String   @unique
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([hits])
  @@index([lastSeenAt])
  @@map("page_visits")
}

// --- Configuración de la Tienda ---

model ConfiguracionTienda {
  id             String  @id @default(cuid())
  whatsappNumber String
  bannerText     String?
  showBanner     Boolean @default(false)

  @@map("configuracion_tienda")
}

// --- Banners del carrusel principal (home) ---

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}
